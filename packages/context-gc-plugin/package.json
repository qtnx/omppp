{
	"type": "module",
	"name": "@oh-my-pi/context-gc-plugin",
	"version": "1.7.12",
	"description": "Durable context unloading extension for omp",
	"homepage": "https://omp.sh",
	"author": "Can Boluk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/context-gc-plugin"
	},
	"keywords": [
		"context",
		"extension",
		"memory",
		"unload"
	],
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test --parallel",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
	},
	"dependencies": {
		"@oh-my-pi/omptype": "catalog:",
		"@oh-my-pi/pi-agent-core": "workspace:*",
		"@oh-my-pi/pi-ai": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "workspace:*",
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^15"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"exports": {
		".": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		},
		"./extension": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"README.md"
	]
}
